# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=root**
DB_NAME=elfulk

# TypeORM (disable synchronize in production)
TYPEORM_SYNC=true

# Better Auth (generate secret with: pnpm -dlx auth secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (https://developer.apple.com)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Super Admin seed
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=SecurePass123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
